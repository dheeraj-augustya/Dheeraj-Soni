# GEMINI_API_KEY: Required for Gemini AI API calls in /api/chat.js
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# GEMINI_MODEL: Gemini model ID (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Contact messages are relayed by FormSubmit. Activate the inbox once.
CONTACT_EMAIL=dheerajsoni.dev@gmail.com
# Optional: use Resend instead of the FormSubmit relay (server-only secret).
# RESEND_API_KEY=re_your_key_here
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Use a verified sender domain for production. The test sender only mails the account owner.
# Optional canonical public website URL used in notification emails:
# PUBLIC_SITE_URL=https://your-domain.example

# Optional random form ID from the FormSubmit activation email:
# FORMSUBMIT_FORM_ID=your_32_character_form_id
